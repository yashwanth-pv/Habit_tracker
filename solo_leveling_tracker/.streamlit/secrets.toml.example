# Copy this file to .streamlit/secrets.toml and fill in your own values.
# NEVER commit the real secrets.toml to git.

GITHUB_TOKEN = "github_pat_xxx..."   # fine-grained PAT, Contents: Read & Write on the repo below
GITHUB_OWNER = "your-github-username"
GITHUB_REPO  = "habit-tracker-data"  # a small repo/gist-like repo just to hold the JSON file
