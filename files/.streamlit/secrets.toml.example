# Copy this file to .streamlit/secrets.toml for local runs (and add secrets.toml to .gitignore!)
# On Streamlit Community Cloud, paste the same keys/values into
# App settings -> Secrets instead of committing a file.

GITHUB_TOKEN  = "github_pat_xxxxxxxxxxxxxxxxxxxxxxxx"   # fine-grained PAT, Contents: Read & write
GITHUB_REPO   = "your-username/your-repo"                 # repo that stores your save data
GITHUB_PATH   = "data/save.json"                           # path to the save file in that repo
GITHUB_BRANCH = "main"                                      # optional, defaults to "main"
